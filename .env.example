# Voyage AI
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_EMBEDDING_MODEL=voyage-4
# Optional: embedding dimension (model-dependent; leave blank for default)
# VOYAGE_EMBEDDING_DIMENSION=

# Precedent store backend: "memory" (standalone/demo) or "atlas"
PRECEDENT_STORE=memory

# MongoDB Atlas (required when PRECEDENT_STORE=atlas)
# Keep credentials on the backend only — never commit real values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=chronicle
MONGODB_PRECEDENTS_COLLECTION=precedents
# Name of the Atlas Vector Search index on the precedents collection
MONGODB_VECTOR_INDEX=precedent_vector_index

# Retrieval defaults
PRECEDENT_TOP_K=5
PRECEDENT_MIN_SCORE=0.0
