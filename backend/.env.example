# App persistence: memory is process-local; MongoDB requires an Atlas URI.
CHRONICLE_STORAGE_MODE=memory
CHRONICLE_APP_ENV=development

# Precedent retrieval: memory uses the empty development mock; atlas calls Danny's retrieval module.
PRECEDENT_STORE=memory
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4

# Atlas connection settings; MONGODB_URI is also used for app persistence when enabled.
MONGODB_URI=
MONGODB_DB=chronicle
MONGODB_PRECEDENTS_COLLECTION=precedents
MONGODB_VECTOR_INDEX=precedents_vector_index

CHRONICLE_EVENTS_POLL_INTERVAL=0.5
